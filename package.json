{
  "name": "double-horse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite app --host 0.0.0.0",
    "build": "vite build app --base=./ --outDir ../dist --emptyOutDir && node scripts/pages.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run test:ui",
    "test:ui": "npm run build && node tests/ui-flow.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "jsdom": "27.0.1"
  }
}
